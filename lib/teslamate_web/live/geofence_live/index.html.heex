<aside class="geofences-map-aside">
  <div
    id="geofences-map"
    class="geofences-map"
    phx-hook="GeofencesMap"
    phx-update="ignore"
    data-geofences={@geofences_json}
    data-selected-id={@selected_id}
  >
  </div>
  <p class="has-text-grey is-size-7 mt-2">
    Click a row to zoom. Click again to deselect. Click an empty spot on the map to create a geofence at that location.
  </p>
</aside>

<nav class="breadcrumb" aria-label="breadcrumbs">
  <ul>
    <li><.link navigate={~p"/"}><%= gettext("Home") %></.link></li>
    <li class="is-active">
      <.link navigate={~p"/geo-fences"}><%= gettext("Geo-Fences") %></.link>
    </li>
  </ul>
</nav>

<div class="geofences-toolbar">
  <div class="field geofences-search">
    <div class="control has-icons-left">
      <input
        class="input is-small"
        type="text"
        placeholder="Filter by name"
        name="q"
        value={@filter}
        phx-keyup="filter"
        phx-debounce="200"
      />
      <span class="icon is-small is-left"><i class="mdi mdi-magnify"></i></span>
    </div>
  </div>

  <div class="geofences-actions">
    <button type="button" class="button is-small" phx-click="export" title="Download all geofences as JSON">
      <span class="icon is-small"><i class="mdi mdi-download"></i></span>
      <span>Export</span>
    </button>
    <button type="button" class="button is-small" phx-click="open_import" title="Paste geofences JSON to import">
      <span class="icon is-small"><i class="mdi mdi-upload"></i></span>
      <span>Import</span>
    </button>
    <.link
      navigate={Routes.live_path(@socket, TeslaMateWeb.GeoFenceLive.Form)}
      class="button is-info is-small is-rounded"
    >
      <span><%= gettext("Create") %></span>
      <span class="icon"><span class="mdi mdi-plus"></span></span>
    </.link>
  </div>
</div>

<%= if MapSet.size(@selected_ids) > 0 do %>
  <div class="geofences-bulk-bar">
    <span><%= MapSet.size(@selected_ids) %> selected</span>
    <button
      type="button"
      class="button is-danger is-small"
      phx-hook="ConfirmBulkDelete"
      id="bulk-delete-btn"
      data-count={MapSet.size(@selected_ids)}
    >
      <span class="icon"><i class="mdi mdi-trash-can"></i></span>
      <span>Delete selected</span>
    </button>
  </div>
<% end %>

<% visible = visible_geofences(assigns) %>

<table class="table is-fullwidth geofences-table">
  <thead class="is-hidden-mobile">
    <tr>
      <th style="width: 30px">
        <% all_visible_ids = MapSet.new(visible, & &1.id) %>
        <% all_checked = MapSet.size(all_visible_ids) > 0 and MapSet.subset?(all_visible_ids, @selected_ids) %>
        <input
          type="checkbox"
          phx-click="toggle_select_all"
          checked={all_checked}
          aria-label="Select all visible"
        />
      </th>
      <th phx-click="sort" phx-value-by="name" style="cursor: pointer">
        <%= gettext("Name") %>
        <%= if icon = sort_icon(@sort_by, @sort_dir, :name) do %>
          <span class="icon is-small"><i class={"mdi #{icon}"}></i></span>
        <% end %>
      </th>
      <th phx-click="sort" phx-value-by="cost" style="cursor: pointer">
        <%= gettext("Cost") %>
        <%= if icon = sort_icon(@sort_by, @sort_dir, :cost) do %>
          <span class="icon is-small"><i class={"mdi #{icon}"}></i></span>
        <% end %>
      </th>
      <th phx-click="sort" phx-value-by="visits" style="cursor: pointer">
        Visits
        <%= if icon = sort_icon(@sort_by, @sort_dir, :visits) do %>
          <span class="icon is-small"><i class={"mdi #{icon}"}></i></span>
        <% end %>
      </th>
      <th phx-click="sort" phx-value-by="radius" style="cursor: pointer">
        <%= gettext("Radius") %>
        <%= if icon = sort_icon(@sort_by, @sort_dir, :radius) do %>
          <span class="icon is-small"><i class={"mdi #{icon}"}></i></span>
        <% end %>
      </th>
      <th></th>
    </tr>
  </thead>
  <tbody style="font-variant-numeric: tabular-nums;">
    <%= for geofence <- visible do %>
      <tr
        class={[
          "geofences-row",
          @selected_id == geofence.id && "is-selected-geofence"
        ]}
        phx-click="select"
        phx-value-id={geofence.id}
      >
        <td onclick="event.stopPropagation()" style="width: 30px">
          <input
            type="checkbox"
            phx-click="toggle_select"
            phx-value-id={geofence.id}
            checked={MapSet.member?(@selected_ids, geofence.id)}
          />
        </td>
        <td class="has-text-weight-medium is-truncated" style="min-width: 0; max-width: 220px">
          <%= geofence.name %>
        </td>
        <td class="is-hidden-mobile has-text-weight-light"><%= format_cost(geofence) %></td>
        <% drives = Map.get(@drive_counts, geofence.id, 0) %>
        <% charges = Map.get(@charge_counts, geofence.id, 0) %>
        <td class="is-hidden-mobile has-text-weight-light">
          <%= if drives + charges == 0 do %>
            <span class="has-text-grey-light">—</span>
          <% else %>
            <span title={"#{drives} drives · #{charges} charges"}>
              <span class="icon is-small"><i class="mdi mdi-car"></i></span>
              <%= drives %>
              <span class="icon is-small ml-2"><i class="mdi mdi-ev-station"></i></span>
              <%= charges %>
            </span>
          <% end %>
        </td>
        <td class="is-hidden-mobile has-text-weight-light">
          <%= case @unit_of_length do
            :ft -> geofence.radius |> Convert.m_to_ft() |> round()
            :m -> geofence.radius |> round()
          end %> <%= @unit_of_length %>
        </td>
        <td>
          <div class="field is-grouped is-pulled-right" onclick="event.stopPropagation()">
            <p class="control">
              <.link
                navigate={Routes.live_path(@socket, TeslaMateWeb.GeoFenceLive.Form, geofence, [])}
                class="button is-info is-small is-inverted is-light"
              >
                <span class="icon"><span class="mdi mdi-square-edit-outline"></span></span>
              </.link>
            </p>
            <p class="control">
              <%= link(raw("<span class='icon'><span class='mdi mdi-trash-can'></span></span>"),
                to: "#",
                phx_hook: "ConfirmGeoFenceDeletion",
                data: [
                  id: geofence.id,
                  msg: gettext("Delete '%{geo_fence}'?", geo_fence: geofence.name)
                ],
                type: "button",
                id: "delete_#{geofence.id}",
                class: "button is-danger is-small is-inverted is-light"
              ) %>
            </p>
          </div>
        </td>
      </tr>
    <% end %>
    <%= if visible == [] do %>
      <tr>
        <td colspan="6" class="has-text-centered has-text-grey py-4">
          No geofences match "<%= @filter %>"
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= if @import_open do %>
  <div class="modal is-active" phx-window-keydown="close_import" phx-key="Escape">
    <div class="modal-background" phx-click="close_import"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">Import geofences</p>
        <button class="delete" aria-label="close" phx-click="close_import"></button>
      </header>
      <section class="modal-card-body">
        <p class="mb-2 is-size-7 has-text-grey">
          Paste an array of geofence objects (same shape as Export outputs). Duplicates and invalid entries are skipped.
        </p>
        <form phx-submit="import">
          <textarea
            name="json"
            class="textarea"
            rows="10"
            placeholder='[{"name":"Home","latitude":45.82,"longitude":16.06,"radius":30,"billing_type":"per_kwh","cost_per_unit":0.09}]'
          ></textarea>
          <%= if @import_error do %>
            <p class="help is-danger mt-2"><%= @import_error %></p>
          <% end %>
          <div class="field is-grouped is-grouped-right mt-3">
            <p class="control"><button type="button" class="button" phx-click="close_import">Cancel</button></p>
            <p class="control"><button type="submit" class="button is-info">Import</button></p>
          </div>
        </form>
      </section>
    </div>
  </div>
<% end %>
